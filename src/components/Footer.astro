---
interface Props {
  variant?: "one" | "two" | "three" | "four" | "cmn";
  logo?: string;
  isLight?: boolean;
}

const {
  variant = "two",
  logo = "/assets/images/logo.png",
  isLight = false,
} = Astro.props;
---
{/* ===== FOOTER VARIANT ONE (Home 1 - Creative Agency) ===== */}
{(variant === "one" || variant === "default") && (
  <footer
    class="footer section pb-0"
    data-background="/assets/images/footer/footer-bg.png"
  >
     <div class="container">
        <div class="row gaper">
           <div class="col-12 col-lg-5 col-xl-6">
              <div class="footer__single">
                 <a href="/" class="logo">
                    <img src={logo} alt="Xpovio">
                 </a>
                 <div class="footer__single-meta">
                    <a href="https://maps.app.goo.gl/wL8rsqb2aCgD1b3r5" target="_blank">
                       <i class="fa-sharp fa-solid fa-location-dot"></i>
                       901 N Pitt Str., Suite 170 Alexandria, USA
                    </a>
                    <a href="mailto:info@xpovio.com">
                       <i class="fa-sharp fa-solid fa-envelope"></i>
                       info@xpovio.com
                    </a>
                    <a href="tel:406-555-0120">
                       <i class="fa-sharp fa-solid fa-phone-volume"></i>
                       (406) 555-0120
                    </a>
                 </div>
                 <p class="secondary-text">
                    Welcome to our digital agency We specialize in helping business most like yours succeed online.
                 </p>
                 <div class="footer__single-form">
                    <form action="#" method="post">
                       <div class="input-email">
                          <input type="email" name="subscribe-news" id="subscribeNews" placeholder="Enter Your Email" required>
                          <button type="submit" class="subscribe" aria-label="subscribe to our newsletter">
                             <i class="fa-sharp fa-solid fa-paper-plane"></i>
                          </button>
                       </div>
                    </form>
                 </div>
              </div>
           </div>
           <div class="col-12 col-md-6 col-lg-3 col-xl-2">
              <div class="footer__single">
                 <div class="footer__single-intro">
                    <h5>about company</h5>
                 </div>
                 <div class="footer__single-content">
                    <ul>
                       <li><a href="/about-us">About Us</a></li>
                       <li><a href="/our-services">Our Services</a></li>
                       <li><a href="/our-projects">Our Projects</a></li>
                       <li><a href="/blog">Blog</a></li>
                       <li><a href="/contact-us">Contact Us</a></li>
                    </ul>
                 </div>
              </div>
           </div>
           <div class="col-12 col-md-6 col-lg-4 col-xl-4">
              <div class="footer__single">
                 <div class="footer__single-intro">
                    <h5>Subscribe Newsletter</h5>
                 </div>
                 <div class="footer__single-content">
                    <p>
                       Subscribe to our newsletter to receive daily updates and regular news.
                    </p>
                    <div class="social justify-content-start mt-4">
                       <a href="https://www.facebook.com/" target="_blank" aria-label="facebook">
                          <i class="fa-brands fa-facebook-f"></i>
                       </a>
                       <a href="https://www.twitter.com/" target="_blank" aria-label="twitter">
                          <i class="fa-brands fa-twitter"></i>
                       </a>
                       <a href="https://www.pinterest.com/" target="_blank" aria-label="pinterest">
                          <i class="fa-brands fa-linkedin-in"></i>
                       </a>
                       <a href="https://www.instagram.com/" target="_blank" aria-label="instagram">
                          <i class="fa-brands fa-instagram"></i>
                       </a>
                    </div>
                 </div>
              </div>
           </div>
        </div>
        <div class="row">
           <div class="col-12">
              <div class="footer__copyright">
                 <div class="row align-items-center gaper">
                    <div class="col-12 col-lg-8">
                       <div class="footer__copyright-text text-center text-lg-start">
                          <p>
                             Copyright &copy;
                             <span id="copyYear"></span>
                             Xpovio. All rights reserved.
                          </p>
                       </div>
                    </div>
                    <div class="col-12 col-lg-4">
                       <div class="social justify-content-center justify-content-lg-end">
                          <a href="https://www.facebook.com/" target="_blank" aria-label="facebook">
                             <i class="fa-brands fa-facebook-f"></i>
                          </a>
                          <a href="https://www.twitter.com/" target="_blank" aria-label="twitter">
                             <i class="fa-brands fa-twitter"></i>
                          </a>
                          <a href="https://www.pinterest.com/" target="_blank" aria-label="pinterest">
                             <i class="fa-brands fa-linkedin-in"></i>
                          </a>
                          <a href="https://www.instagram.com/" target="_blank" aria-label="instagram">
                             <i class="fa-brands fa-instagram"></i>
                          </a>
                       </div>
                    </div>
                 </div>
              </div>
           </div>
        </div>
     </div>
  </footer>
)}

{/* ===== FOOTER VARIANT TWO / CMN (Home 2 & All Inner Pages) ===== */}
{(variant === "two" || variant === "cmn") && (
  <footer class={`footer-two section ${isLight ? "" : "footer-cmn"} section pb-0`}>
     <div class="container">
        <div class="row gaper">
           <div class="col-12 col-lg-5 col-xl-4">
              <div class="footer-two__single">
                 <a href="/" class="logo">
                    <img src={logo} alt="Xpovio">
                 </a>
                 <p class="secondary-text">
                    Welcome to our digital agency We specialize in helping business most like yours succeed online. From website design and development to SEO and digital advertising, we have the tools to boost your brand.
                 </p>
                 <div class="footer__single-meta mt-4">
                    <a href="https://maps.app.goo.gl/wL8rsqb2aCgD1b3r5" target="_blank">
                       <i class="fa-sharp fa-solid fa-location-dot"></i>
                       901 N Pitt Str., Suite 170 Alexandria, USA
                    </a>
                    <a href="mailto:info@xpovio.com">
                       <i class="fa-sharp fa-solid fa-envelope"></i>
                       info@xpovio.com
                    </a>
                    <a href="tel:406-555-0120">
                       <i class="fa-sharp fa-solid fa-phone-volume"></i>
                       (406) 555-0120
                    </a>
                 </div>
              </div>
           </div>
           <div class="col-12 col-lg-7 col-xl-7 offset-xl-1">
              <div class="footer-two__social">
                 <div class="social justify-content-start justify-content-lg-end">
                    <a href="https://www.facebook.com/" target="_blank">
                       <span>Facebook</span>
                       <i class="fa-brands fa-facebook-f"></i>
                    </a>
                    <a href="https://www.twitter.com/" target="_blank">
                       <span>Twitter</span>
                       <i class="fa-brands fa-twitter"></i>
                    </a>
                    <a href="https://www.pinterest.com/" target="_blank">
                       <span>Linkedin</span>
                       <i class="fa-brands fa-linkedin-in"></i>
                    </a>
                    <a href="https://www.instagram.com/" target="_blank">
                       <span>Instagram</span>
                       <i class="fa-brands fa-instagram"></i>
                    </a>
                 </div>
              </div>
           </div>
        </div>
        <div class="row">
           <div class="col-12">
              <div class="footer__copyright">
                 <div class="row align-items-center gaper">
                    <div class="col-12 col-lg-8">
                       <div class="footer__copyright-text text-center text-lg-start">
                          <p>
                             Copyright &copy;
                             <span id="copyYear"></span>
                             Xpovio. All Rights Reserved.
                          </p>
                       </div>
                    </div>
                    <div class="col-12 col-lg-4">
                       <ul class="justify-content-center justify-content-lg-end">
                          <li><a href="/about-us">About Us</a></li>
                          <li><a href="/our-services">Services</a></li>
                          <li><a href="/our-projects">Projects</a></li>
                          <li><a href="/contact-us">Contact</a></li>
                       </ul>
                    </div>
                 </div>
              </div>
           </div>
        </div>
     </div>
  </footer>
)}

{/* ===== FOOTER VARIANT THREE (Home 3 - IT Solution) ===== */}
{variant === "three" && (
  <footer class="section footer-three pb-0">
     <div class="container">
        <div class="row gaper">
           <div class="col-12 col-lg-4">
              <div class="footer-thumb">
                 <img src="/assets/images/footer/footer-three-thumb.png" alt="Footer Thumbnail">
                 <div class="footer-thumb__content">
                    <h5>Based in Alexandria, USA</h5>
                 </div>
              </div>
           </div>
           <div class="col-12 col-lg-8">
              <div class="footer-three__group">
                 <div class="intro">
                    <h5>Contact Information</h5>
                 </div>
                 <ul>
                    <li>
                       <a href="https://maps.app.goo.gl/wL8rsqb2aCgD1b3r5" target="_blank">
                          <i class="fa-sharp fa-solid fa-location-dot"></i>
                          901 N Pitt Str., Suite 170 Alexandria, USA
                       </a>
                    </li>
                    <li>
                       <a href="mailto:info@xpovio.com">
                          <i class="fa-sharp fa-solid fa-envelope"></i>
                          info@xpovio.com
                       </a>
                    </li>
                    <li>
                       <a href="tel:406-555-0120">
                          <i class="fa-sharp fa-solid fa-phone-volume"></i>
                          (406) 555-0120
                       </a>
                    </li>
                 </ul>
                 <div class="cta">
                    <a href="/contact-us">
                       Let's Talk
                       <i class="fa-solid fa-arrow-up-right"></i>
                    </a>
                 </div>
              </div>
           </div>
        </div>
        <div class="row">
           <div class="col-12">
              <div class="footer-three__copyright">
                 <div class="row align-items-center gaper">
                    <div class="col-12 col-lg-8">
                       <div class="footer__copyright-text text-center text-lg-start">
                          <p>
                             Copyright &copy;
                             <span id="copyYear"></span>
                             Xpovio. All rights reserved.
                          </p>
                       </div>
                    </div>
                    <div class="col-12 col-lg-4">
                       <div class="social justify-content-center justify-content-lg-end">
                          <a href="https://www.facebook.com/" target="_blank" aria-label="facebook">
                             <i class="fa-brands fa-facebook-f"></i>
                          </a>
                          <a href="https://www.twitter.com/" target="_blank" aria-label="twitter">
                             <i class="fa-brands fa-twitter"></i>
                          </a>
                          <a href="https://www.pinterest.com/" target="_blank" aria-label="pinterest">
                             <i class="fa-brands fa-linkedin-in"></i>
                          </a>
                          <a href="https://www.instagram.com/" target="_blank" aria-label="instagram">
                             <i class="fa-brands fa-instagram"></i>
                          </a>
                       </div>
                    </div>
                 </div>
              </div>
           </div>
        </div>
     </div>
  </footer>
)}

{/* ===== FOOTER VARIANT FOUR (Home 4 & Home 5 - Portfolio) ===== */}
{variant === "four" && (
  <footer class="section footer-four pb-0">
     <div class="container">
        <div class="row">
           <div class="col-12">
              <div class="cta-t text-center">
                 <a href="/contact-us">
                    <h2>LET'S TALK</h2>
                    <i class="fa-sharp fa-solid fa-arrow-up-right"></i>
                 </a>
                 <p>Have an awesome project in mind? We'd love to chat.</p>
              </div>
           </div>
        </div>
        <div class="row">
           <div class="col-12">
              <div class="footer-three__copyright">
                 <div class="row align-items-center gaper">
                    <div class="col-12 col-lg-8">
                       <div class="footer__copyright-text text-center text-lg-start">
                          <p>
                             Copyright &copy;
                             <span id="copyYear"></span>
                             Xpovio. All rights reserved.
                          </p>
                       </div>
                    </div>
                    <div class="col-12 col-lg-4">
                       <div class="social justify-content-center justify-content-lg-end">
                          <a href="https://www.facebook.com/" target="_blank" aria-label="facebook">
                             <i class="fa-brands fa-facebook-f"></i>
                          </a>
                          <a href="https://www.twitter.com/" target="_blank" aria-label="twitter">
                             <i class="fa-brands fa-twitter"></i>
                          </a>
                          <a href="https://www.pinterest.com/" target="_blank" aria-label="pinterest">
                             <i class="fa-brands fa-linkedin-in"></i>
                          </a>
                          <a href="https://www.instagram.com/" target="_blank" aria-label="instagram">
                             <i class="fa-brands fa-instagram"></i>
                          </a>
                       </div>
                    </div>
                 </div>
              </div>
           </div>
        </div>
     </div>
  </footer>
)}
